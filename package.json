{
  "name": "lincoln-dirt-gravel",
  "version": "0.0.0",
  "private": true,
  "description": "Lincoln Dirt and Gravel operating system",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "api:check": "pnpm api:openapi && pnpm api:client",
    "api:client": "pnpm --filter @ldg/api-client generate",
    "api:openapi": "pnpm --filter @ldg/server api:openapi",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rimraf .turbo coverage",
    "db:down": "pnpm --filter @ldg/database db:down",
    "db:generate": "pnpm --filter @ldg/database db:generate",
    "db:migrate": "pnpm --filter @ldg/database db:migrate",
    "db:reset": "pnpm --filter @ldg/database db:reset",
    "db:seed": "pnpm --filter @ldg/database db:seed",
    "db:studio": "pnpm --filter @ldg/database db:studio",
    "db:up": "pnpm --filter @ldg/database db:up",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @ldg/server dev:api",
    "dev:web": "pnpm --filter @ldg/web dev",
    "dev:worker": "pnpm --filter @ldg/server dev:worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
