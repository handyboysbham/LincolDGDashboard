# Local development only. Replace these values before using any shared environment.
APP_ENV=local
LDG_TIMEZONE=America/Chicago

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lincoln_dirt_gravel
POSTGRES_ADMIN_USER=ldg_admin
POSTGRES_ADMIN_PASSWORD=ldg_local_admin_change_me
POSTGRES_MIGRATION_USER=ldg_migrator
POSTGRES_MIGRATION_PASSWORD=ldg_local_migrator_change_me
POSTGRES_RUNTIME_USER=ldg_app
POSTGRES_RUNTIME_PASSWORD=ldg_local_runtime_change_me
DATABASE_MIGRATION_URL=postgresql://ldg_migrator:ldg_local_migrator_change_me@127.0.0.1:5432/lincoln_dirt_gravel
DATABASE_URL=postgresql://ldg_app:ldg_local_runtime_change_me@127.0.0.1:5432/lincoln_dirt_gravel

MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ldg_minio_admin
MINIO_ROOT_PASSWORD=ldg_local_minio_admin_change_me
MINIO_APP_USER=ldg_documents_app
MINIO_APP_PASSWORD=ldg_local_documents_change_me
MINIO_BUCKET=ldg-documents
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_FORCE_PATH_STYLE=true

MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=local@lincolndirtandgravel.test
