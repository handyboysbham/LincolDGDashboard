# Copy values into the deployment platform's secret manager. Never commit populated credentials.
APP_ENV=production
LDG_PROCESS=api
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_ORIGIN=https://YOUR_API_HOST
WEB_ORIGIN=https://YOUR_WEB_HOST
NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_HOST

AUTH_MODE=jwt
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
AUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Runtime may use the Supabase session pooler; migrations and pg_dump use the direct connection.
DATABASE_URL=postgresql://YOUR_RUNTIME_ROLE.YOUR_PROJECT_REF:YOUR_RUNTIME_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_MIGRATION_URL=postgresql://YOUR_MIGRATION_ROLE:YOUR_MIGRATION_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Direct administrative connection used only by the isolated backup job; required for FORCE RLS.
DATABASE_BACKUP_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_MAX=10
EXPECTED_DATABASE_RELEASE=1.10.0-rc.3

WORKER_ID=production-worker-1
WORKER_TENANT_IDS=YOUR_TENANT_UUID
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_STALE_AFTER_MS=30000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
READY_REQUIRE_WORKER=true
READY_MAX_OUTBOX_AGE_SECONDS=900
READY_MAX_DEAD_LETTER_EVENTS=0
LOG_REQUESTS=true

DOCUMENT_STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT@YOUR_GCP_PROJECT.iam.gserviceaccount.com
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=YOUR_BASE64_ENCODED_PEM_PRIVATE_KEY
GOOGLE_DRIVE_SHARED_DRIVE_ID=YOUR_SHARED_DRIVE_ID
GOOGLE_DRIVE_DOCUMENT_FOLDER_ID=YOUR_DOCUMENT_FOLDER_ID
DOCUMENT_MAX_UPLOAD_BYTES=20971520
DOCUMENT_PRESIGN_EXPIRES_SECONDS=300
DOCUMENT_PUBLIC_LINK_EXPIRES_SECONDS=86400
DOCUMENT_PUBLIC_LINK_SIGNING_KEY=YOUR_RANDOM_64_CHARACTER_OR_LONGER_SIGNING_KEY

MAIL_FROM=operations@YOUR_DOMAIN
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_EMAIL_API_URL=https://api.resend.com
NOTIFICATION_EMAIL_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_SMS_PROVIDER=disabled
NOTIFICATION_TWILIO_API_BASE_URL=https://api.twilio.com
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
NOTIFICATION_REMINDER_LEAD_MINUTES=1440

# Isolated release job only. Do not copy these confirmations or identity values into API/worker.
OBJECT_STORAGE_VERIFY_CONFIRM=VERIFY_PRIVATE_VERSIONED_DRIVE
GOOGLE_DRIVE_BACKUP_FOLDER_ID=YOUR_BACKUP_FOLDER_ID
GOOGLE_DRIVE_BACKUP_SHARED_DRIVE_ID=YOUR_BACKUP_SHARED_DRIVE_ID
GOOGLE_DRIVE_BACKUP_SERVICE_ACCOUNT_EMAIL=YOUR_BACKUP_SERVICE_ACCOUNT@YOUR_GCP_PROJECT.iam.gserviceaccount.com
GOOGLE_DRIVE_BACKUP_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=YOUR_BACKUP_BASE64_ENCODED_PEM_PRIVATE_KEY
DATABASE_BACKUP_ENCRYPTION_KEY_BASE64=YOUR_RANDOM_BASE64_ENCODED_32_BYTE_KEY
BOOTSTRAP_CONFIRM=PROVISION_TENANT_FOUNDATION
BOOTSTRAP_TENANT_ID=YOUR_TENANT_UUID
BOOTSTRAP_USER_ID=YOUR_OWNER_APPLICATION_USER_UUID
BOOTSTRAP_ORGANIZATION_DISPLAY_NAME=Lincoln Dirt and Gravel
BOOTSTRAP_ORGANIZATION_LEGAL_NAME=YOUR_LEGAL_BUSINESS_NAME
BOOTSTRAP_OWNER_DISPLAY_NAME=YOUR_OWNER_DISPLAY_NAME
BOOTSTRAP_OWNER_EMAIL=YOUR_OWNER_EMAIL
BOOTSTRAP_TIMEZONE=America/Chicago
BOOTSTRAP_APPROVED_BY=YOUR_RELEASE_APPROVER
BOOTSTRAP_CHANGE_TICKET=LDG-RELEASE-1.10.0
BOOTSTRAP_AUTH_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID
