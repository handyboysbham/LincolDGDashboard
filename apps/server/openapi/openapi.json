            }
          }
        },
        "summary": "",
        "tags": ["Documents"]
      }
    },
    "/api/v1/documents/{id}/public-links": {
      "post": {
        "operationId": "createDocumentPublicLink",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
