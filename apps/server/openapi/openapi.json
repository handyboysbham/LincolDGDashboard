  "info": {
    "title": "Lincoln Dirt and Gravel API",
    "description": "Lincoln Dirt and Gravel operating system API",
    "version": "1.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LiveHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["status", "timestamp"]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": ["ready"]
          },
          "migrations": {
            "type": "string",
            "enum": ["ready"]
          },
          "objectStorage": {
            "type": "string",
            "enum": ["ready"]
          },
          "worker": {
            "type": "string",
            "enum": ["ready", "skipped"]
          }
        },
        "required": ["database", "migrations", "objectStorage", "worker"]
      },
      "ReadyHealthDto": {
        "type": "object",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          },
          "status": {
            "type": "string",
            "example": "ready"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["checks", "status", "timestamp"]
      },
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "correlationId", "message"]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          }
        },
        "required": ["error"]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["permissions", "tenantId", "userId"]
      },
      "CreateDocumentUploadDto": {
        "type": "object",
        "properties": {
          "originalFilename": {
            "type": "string",
            "example": "supplier-ticket.pdf",
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "enum": ["application/pdf", "image/jpeg", "image/png", "text/plain"]
          },
          "sizeBytes": {
            "type": "number",
            "maximum": 104857600,
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "minLength": 64
          }
        },
        "required": ["originalFilename", "mediaType", "sizeBytes", "sha256"]
      },
      "DocumentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mediaType": {
            "type": "string"
          },
          "originalFilename": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "available", "rejected"]
          }
        },
        "required": ["id", "mediaType", "originalFilename", "sizeBytes", "status"]
      },
      "DocumentUploadTargetDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["expiresAt", "headers", "url"]
      },
      "CreateDocumentUploadResponseDto": {
        "type": "object",
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentDto"
          },
          "upload": {
            "$ref": "#/components/schemas/DocumentUploadTargetDto"
          }
        },
        "required": ["document", "upload"]
      },
      "DocumentDownloadDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["expiresAt", "url"]
      },
      "CreateDocumentPublicLinkDto": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "number",
            "default": 86400,
            "maximum": 604800,
            "minimum": 60
          },
          "scope": {
            "type": "string",
            "default": "download",
            "enum": ["download"]
          }
        },
        "required": ["scope"]
      },
      "DocumentPublicLinkDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "linkId": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "type": "string",
            "enum": ["download"]
          },
          "token": {
            "type": "string",
            "description": "Plaintext capability returned only to the creator"
          }
        },
        "required": ["expiresAt", "linkId", "scope", "token"]
      },
      "PublicDocumentDownloadDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "document": {
            "$ref": "#/components/schemas/DocumentDto"
          }
        },
        "required": ["expiresAt", "url", "document"]
      }
    }
  }
}
