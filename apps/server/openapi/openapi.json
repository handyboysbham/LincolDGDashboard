          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocumentPublicLinkDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPublicLinkDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["Documents"]
      }
    },
    "/api/v1/documents/{id}/public-links/{linkId}/actions/revoke": {
      "post": {
        "operationId": "revokeDocumentPublicLink",
