    "/api/v1/documents/uploads": {
      "post": {
        "operationId": "createDocumentUpload",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocumentUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDocumentUploadResponseDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["Documents"]
      }
    },
    "/api/v1/documents/{id}/actions/complete": {
      "post": {
        "operationId": "completeDocumentUpload",
        "parameters": [
          {
            "name": "id",
