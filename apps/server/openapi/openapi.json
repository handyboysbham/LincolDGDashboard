{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealthDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["Health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadyHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealthDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["Health"]
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getCurrentSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": ["Identity"]
      }
    }
  },
  "info": {
    "title": "Lincoln Dirt and Gravel API",
    "description": "Lincoln Dirt and Gravel operating system API",
    "version": "1.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LiveHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["status", "timestamp"]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": ["ready"]
          },
          "migrations": {
            "type": "string",
            "enum": ["ready"]
          },
          "objectStorage": {
            "type": "string",
            "enum": ["ready"]
          },
          "worker": {
            "type": "string",
            "enum": ["ready", "skipped"]
          }
        },
        "required": ["database", "migrations", "objectStorage", "worker"]
      },
      "ReadyHealthDto": {
        "type": "object",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          },
          "status": {
            "type": "string",
            "example": "ready"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["checks", "status", "timestamp"]
      },
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "correlationId", "message"]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          }
        },
        "required": ["error"]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["permissions", "tenantId", "userId"]
      }
    }
  }
}
